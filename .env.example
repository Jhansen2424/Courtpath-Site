# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Dashboard > Product catalog). Signup requires a card for every plan; nothing is
# charged before BILLING_START. Bronze has no price: its card is saved for the $4 per-filing charge.
STRIPE_PRICE_BRONZE_PLUS=price_REPLACE_ME
# Silver: $25/month
STRIPE_PRICE_SILVER=price_REPLACE_ME
# Gold: $21/month per attorney (quantity = attorneys)
STRIPE_PRICE_GOLD=price_REPLACE_ME
# Platinum: $240/year per attorney (quantity = attorneys)
STRIPE_PRICE_PLATINUM=price_REPLACE_ME

# Signing secret of the Stripe webhook https://www.courtpath.com/api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# First billing moment (default 2027-01-01T07:00:00Z = midnight Mountain time, Jan 1, 2027)
#BILLING_START=2027-01-01T07:00:00Z

# App URL (used for Stripe checkout success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Courtpath API
COURTPATH_API_URL=https://courtpath-production.up.railway.app
COURTPATH_COMPANY_ID=b335c44b-2ba0-490a-993f-55837e7b9f99
# Signups create the app account automatically. Same value as SIGNUP_API_KEY on the app (Railway).
COURTPATH_SIGNUP_KEY=

# Seals the chosen password on the Stripe customer until the account exists (64 hex chars: openssl rand -hex 32)
SIGNUP_ENCRYPTION_KEY=your_32_byte_hex_key_here

# Mailer (Gmail app password for contact form → sends to support@courtpath.com)
MAILER_AUTH_USER=your_email@example.com
MAILER_AUTH_PASS=your_app_password
